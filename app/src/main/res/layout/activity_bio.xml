<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/them">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="15dp"
        android:background="#09ffffff">

        <EditText
            android:id="@+id/input_et"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="@null"
            android:gravity="top|left"
            android:hint="Tell people more about yourself, click here to add"
            android:textColor="@color/white"
            android:textColorHint="#49ffffff"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/completed_bt"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="58dp"
        android:layout_marginRight="58dp"
        android:layout_marginBottom="116dp"
        android:background="@drawable/bg_button_17"
        android:text="Completed"
        android:textColor="@color/white"
        android:textSize="14sp" />
</RelativeLayout>