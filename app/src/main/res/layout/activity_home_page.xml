<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/qmui_config_color_white"
        app:qmui_skin_background="?attr/app_skin_common_background">

        <com.qmuiteam.qmui.widget.QMUIAppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">
            <!--app:layout_scrollFlags="scroll|enterAlways"-->
            <com.qmuiteam.qmui.widget.QMUICollapsingTopBarLayout
                android:id="@+id/collapsing_topbar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="?attr/qmui_topbar_height"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:qmui_collapsedTitleGravity="center"
                app:qmui_contentScrim="?attr/qmui_config_color_blue"
                app:qmui_expandedTitleGravity="center_horizontal|bottom"
                app:qmui_expandedTitleMarginBottom="20dp"
                app:qmui_followTopBarCommonSkin="true"
                app:qmui_statusBarScrim="?attr/qmui_config_color_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/them"
                    android:fitsSystemWindows="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:qmui_layout_collapseMode="parallax"
                    app:qmui_layout_collapseParallaxMultiplier="0.7">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="87dp"
                        android:layout_height="87dp"
                        android:layout_marginTop="37dp"
                        android:src="@drawable/default_icon" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="47dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hyppers"
                                android:textColor="#70ffffff"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginLeft="47dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="80"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hypping"
                                android:textColor="#70ffffff"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="47dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="667"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Likes"
                                android:textColor="#70ffffff"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/facus_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginRight="15dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Someone you might be interested in"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/focus_iv"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/icon_tarenzhuye_yiguanzhu" />

                        <ImageView
                            android:id="@+id/recommended_iv"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginLeft="3dp"
                            android:src="@drawable/icon_tarenzhuye_shouqituijian" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="15dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginRight="15dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Maria Roberts"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <com.qmuiteam.qmui.alpha.QMUIAlphaButton
                            android:id="@+id/follow_bt"
                            android:layout_width="75dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_un_follow_big"
                            android:text="Follow"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/info_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="15dp"
                        android:text="Inspiration is for amateurs."
                        android:textColor="#70ffffff"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="22dp">

                        <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_home_page_button"
                            android:gravity="center_vertical"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp">

                            <ImageView
                                android:id="@+id/sex_iv"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/icon_tarenzhuye_xingbie" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Female"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

                        <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginLeft="5dp"
                            android:background="@drawable/bg_home_page_button"
                            android:gravity="center_vertical"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Malaysia"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

                        <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginLeft="5dp"
                            android:background="@drawable/bg_home_page_button"
                            android:gravity="center_vertical"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp">

                            <TextView
                                android:id="@+id/age_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <com.qmuiteam.qmui.widget.QMUITopBar
                    android:id="@+id/topbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/qmui_topbar_height"
                    android:background="@color/qmui_config_color_transparent"
                    android:fitsSystemWindows="true"
                    app:qmui_bottomDividerHeight="0px"
                    app:qmui_layout_collapseMode="pin"
                    app:qmui_topbar_left_back_drawable_id="@color/transparent" />
            </com.qmuiteam.qmui.widget.QMUICollapsingTopBarLayout>

            <com.flyco.tablayout.SlidingTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/them"
                app:tl_indicator_color="#FF2D54"
                app:tl_indicator_corner_radius="1dp"
                app:tl_indicator_gravity="BOTTOM"
                app:tl_indicator_height="2dp"
                app:tl_indicator_width="24dp"
                app:tl_indicator_width_equal_title="true"
                app:tl_tab_space_equal="true"
                app:tl_textSelectColor="@color/white"
                app:tl_textUnselectColor="#70ffffff"
                app:tl_textsize="15sp"
                app:tl_underline_height="0dp" />
        </com.qmuiteam.qmui.widget.QMUIAppBarLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <View
        android:id="@+id/top_view_page"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <RelativeLayout
        android:id="@+id/top_ly"
        android:layout_width="match_parent"
        android:layout_height="?attr/qmui_topbar_height"
        android:layout_below="@id/top_view_page"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:src="@drawable/page_back" />

        <TextView
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:text="Maria Roberts"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </RelativeLayout>
</RelativeLayout>