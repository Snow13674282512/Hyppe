<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/them"
    android:orientation="vertical">

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Comments"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/comments_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:background="#50ffffff" />

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hyppe"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/hyppe_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:background="#50ffffff" />

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mentioned"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/mentioned_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:background="#50ffffff" />

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Friend Request"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/friend_request_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:background="#50ffffff" />

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Direct Message Request"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/direct_message_request_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:background="#50ffffff" />
</LinearLayout>