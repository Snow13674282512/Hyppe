<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/them"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="152dp">

        <com.qmuiteam.qmui.alpha.QMUIAlphaRelativeLayout
            android:id="@+id/select_img_rl"
            android:layout_width="85dp"
            android:layout_height="110dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="15dp">

            <ImageView
                android:id="@+id/cover_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/placeholder" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:layout_alignParentBottom="true"
                android:background="#50000000"
                android:gravity="center"
                android:text="选封面"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </com.qmuiteam.qmui.alpha.QMUIAlphaRelativeLayout>

        <com.qmuiteam.qmui.alpha.QMUIAlphaTextView
            android:id="@+id/topic_tv"
            android:layout_width="52dp"
            android:layout_height="25dp"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_topic"
            android:gravity="center"
            android:text="#Topic"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/title_et"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/topic_tv"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="13dp"
            android:layout_toLeftOf="@id/select_img_rl"
            android:background="@null"
            android:gravity="top"
            android:hint="Write a headline and use the right topic to reach more people see"
            android:textColor="@color/white"
            android:textColorHint="#50ffffff"
            android:textSize="14sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:background="#eeeeee" />

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:id="@+id/location_ll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_fabu_weizhi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Add Location"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_next" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:id="@+id/privacy_ll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_fabu_sheikeyikan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Privacy Setting"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/privacy_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="public"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/icon_next" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_fabu_baocunxiangce" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Save to Camera Roll"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/save_camera_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_fabu_yuxunxiazai" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Allowed to Download"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.suke.widget.SwitchButton
            android:id="@+id/download_sb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sb_checked_color="#EE6028"
            app:sb_uncheck_color="#50ffffff" />
    </LinearLayout>

    <com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout
        android:id="@+id/ownership_ll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_fabu_shanglian" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Blockchain Ownership Authentication"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_next" />
    </com.qmuiteam.qmui.alpha.QMUIAlphaLinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDR"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/price_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="@color/white"
                android:textSize="28dp"
                android:textStyle="bold" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp">

            <com.qmuiteam.qmui.alpha.QMUIAlphaButton
                android:id="@+id/save_bt"
                android:layout_width="165dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_save"
                android:text="Save to Drafts"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.qmuiteam.qmui.alpha.QMUIAlphaButton
                android:id="@+id/next_bt"
                android:layout_width="165dp"
                android:layout_height="44dp"
                android:layout_alignParentRight="true"
                android:background="@drawable/bg_button_feed"
                android:text="Next"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>